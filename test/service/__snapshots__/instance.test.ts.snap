exports[`default service render is unchanged systemd unit bytes 1`] = `
"# generated by \`reflex service install\` — re-rendered on every install; manual edits are overwritten
[Unit]
Description=Reflex — metafactory activation runtime
After=network.target

[Service]
ExecStart="/opt/bun/bin/bun" "/repo/src/bin/reflex-daemon.ts"
WorkingDirectory="/repo"
Restart=always
RestartSec=2
Environment="HOME=/srv/op"

[Install]
WantedBy=default.target
"
`;
