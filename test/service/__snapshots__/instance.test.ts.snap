    <array>
        <string>/opt/bun/bin/bun</string>
        <string>/repo/src/bin/reflex-daemon.ts</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/repo</string>
    <key>RunAtLoad</key>
    <true/>
