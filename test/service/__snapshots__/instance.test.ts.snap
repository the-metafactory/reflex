<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- generated by \`reflex service install\` — re-rendered on every install; manual edits are overwritten -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.meta-factory.reflex</string>
